  const [sx, sz] = await nav.standNear(pb, 21.5, 16.795, 0.9, Math.PI);
  const r = await nav.walkTo(pb, sx, sz, { keycard: true, log: (...a) => log('B', ...a), timeoutMs: 90000 });
