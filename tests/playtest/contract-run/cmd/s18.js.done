const nav = h.nav, pg = A.page, pb = B.page;
const core = await pg.evaluate(() => window.__game.state().objectives.core);
log('core', core.id, core.p, core.state);
const [ra, rb] = await Promise.all([nav.walkTo(pg, 8.1, 3.0, { timeoutMs: 40000, log: (...a) => log('A', ...a) }), nav.walkTo(pb, 9.9, 3.0, { timeoutMs: 40000, log: (...a) => log('B', ...a) })]);
log('to core', ra.ok, ra.end, ra.reason, JSON.stringify(ra.stuck), '|', rb.ok, rb.end, rb.reason, JSON.stringify(rb.stuck));
const aA = await h.aimAt(pg, core.id, 9, 0.6, 3);
const aB = await h.aimAt(pb, core.id, 9, 0.6, 3);
log('aim', aA, aB);
await h.shot(pg, '28-ann-core-prompt');
await h.tap(pg, 'KeyE');
await h.sleep(500);
await h.shot(pg, '29-ann-one-handle');
log('after Ann E', await pg.evaluate(() => { const c = window.__game.state().objectives.core; return { state: c.state, carriers: c.carriers }; }));
await h.tap(pb, 'KeyE');
await h.sleep(800);
const c2 = await pg.evaluate(() => { const c = window.__game.state().objectives.core; return { state: c.state, carriers: c.carriers }; });
log('after Bob E', c2);
await h.shot(pb, '30-bob-core-lifted');
return c2;
