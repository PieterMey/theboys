const pg = A.page, pb = B.page;
const buys = pg.getByRole('button', { name: 'BUY' });
await buys.nth(2).click();
await h.sleep(600);
log('gear after buy', await pg.evaluate(() => { const m = window.__meta.meta(); return { bal: m.shift.balance, gear: m.gear }; }));
await h.tap(pg, 'Escape');
await h.sleep(500);
await h.tap(pg, 'KeyB');
await h.sleep(900);
await pg.mouse.click(420, 300);
await h.sleep(600);
await pg.getByRole('button', { name: /READY UP/ }).first().click();
await h.sleep(400);
await pb.mouse.click(800, 450);
await h.sleep(200);
await h.tap(pb, 'KeyR');
await pg.waitForFunction(() => window.__game.state().phase === 'drive', undefined, { timeout: 20000 }).catch(() => log('no drive'));
await h.sleep(1500);
await h.shot(pb, '44-drive-screen');
await pg.waitForFunction(() => window.__game.state().phase === 'contract', undefined, { timeout: 40000 }).catch(() => log('no contract'));
await pg.waitForFunction(() => window.__game.state().screen === 'none', undefined, { timeout: 30000 }).catch(() => log('screen not none'));
const s = await h.st(pg);
log('phase', s.phase, 'inv A', await pg.evaluate(() => window.__ix.inventory()), 'inv B', await pb.evaluate(() => window.__ix.inventory()));
log('monsters', await pg.evaluate(() => window.__game.dbg('monsters.state').then((m) => ({ frozen: m.frozen, agents: m.agents.map((a) => ({ k: a.kind, st: a.state, x: a.x, z: a.z })) }))));
return {};
