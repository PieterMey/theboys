const pg = A.page;
const yawOf = async () => pg.evaluate(() => { const s = window.__game.state(); const me = s.players.find((p) => p.id === s.me); return me ? me.yaw : null; });
const y0 = await yawOf();
await pg.mouse.move(800, 450);
for (let i = 0; i < 10; i++) { await pg.mouse.move(800 + (i + 1) * 20, 450); await h.sleep(30); }
await h.sleep(400);
const y1 = await yawOf();
log('yaw before/after mouse move', y0, y1);
await h.tap(pg, 'KeyB');
await h.sleep(1200);
const scr = (await h.st(pg)).screen;
log('screen after B:', scr, 'locked:', await pg.evaluate(() => !!document.pointerLockElement));
await h.shot(pg, '05-board');
return { y0, y1, scr };
