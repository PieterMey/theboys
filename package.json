{
  "name": "dead-air",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=C:/Users/Pieter/repos/theboys/.env apps/server/src/index.ts --dev",
    "build": "vite build --config apps/client/vite.config.ts",
    "preview": "node --env-file-if-exists=C:/Users/Pieter/repos/theboys/.env apps/server/src/index.ts --prod",
    "check": "tsc --noEmit && node tools/check-forbidden.mjs && node tools/check-secrets.mjs",
    "selftest": "node apps/server/src/index.ts --selftest",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test \"packages/**/*.test.ts\" \"apps/**/*.test.ts\" \"tools/**/*.test.ts\" \"tests/unit/**/*.test.ts\"",
    "gate:g0": "node tests/gates/g0.mjs",
    "fixtures:voice": "node tests/fixtures/make-voice.mjs",
    "host": "node tools/host.mjs",
    "server:restart": "node tools/server-restart.mjs",
    "ai:check": "node --env-file=C:/Users/Pieter/repos/theboys/.env tools/ai-check.mjs",
    "stt": "powershell -NoProfile -ExecutionPolicy Bypass -File services/stt/run.ps1",
    "stt:test": "node services/stt/test_stt.mjs",
    "gate:g1": "node tests/gates/g1.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@preact/signals": "2.11.3",
    "@ricky0123/vad-web": "0.0.31",
    "@typesafe-ai/sdk": "0.6.0",
    "flatqueue": "3.1.0",
    "msgpackr": "2.1.0",
    "onnxruntime-web": "1.30.0",
    "preact": "11.0.0",
    "sirv": "3.0.2",
    "three": "0.186.1",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.1",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "pixelmatch": "8.0.0",
    "playwright-core": "1.63.0",
    "pngjs": "7.0.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
